# Copy to .env and fill in. Never commit .env. Keys are read only from the environment.

# --- Scopus (Elsevier) — https://dev.elsevier.com ---
SCOPUS_API_KEY=
# optional, for access outside the Technion network
SCOPUS_INST_TOKEN=

# --- Web of Science (Clarivate) — https://developer.clarivate.com ---
# Starter API: lookup + Times Cited
WOS_STARTER_API_KEY=
# Expanded API: citing-records list (only if the library subscribes)
WOS_EXPANDED_API_KEY=

# --- System ---
# FCR_DATA_DIR=./data
# FCR_DATABASE_URL=postgresql+psycopg://user:pass@host/fcr   (default: SQLite in data/)
# Optional: create the first admin automatically instead of the first-run screen
# FCR_ADMIN_USER=admin
# FCR_ADMIN_PASSWORD=
